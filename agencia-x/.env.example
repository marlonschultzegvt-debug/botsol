# ── IA (obrigatório para as funções de IA) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo padrão (opcional). Padrão: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# ── Ferramenta Espião: dados reais do Instagram via Apify (opcional) ──
# Sem token, o Espião faz análise estimada a partir do que você colar.
APIFY_TOKEN=

# ── Banco de dados (Supabase ou Postgres) ────────────────────────
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres

# ── Login (Auth.js) ──────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-longo
# Necessário fora da Vercel (ex.: `npm start` local ou VPS):
AUTH_TRUST_HOST=true

# ── Arquivos do Portal (uploads do cliente) ──────────────────────
# Sem estas variáveis, os arquivos ficam na pasta local .uploads/ (só serve para desenvolvimento).
# Supabase: Project Settings > API. Crie um bucket PRIVADO chamado "assets" em Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=assets
# Limite por arquivo em MB (na Vercel o padrão é 4 por causa do limite da plataforma)
# UPLOAD_MAX_MB=25

# ── Assistente ───────────────────────────────────────────────────
NEXT_PUBLIC_ASSISTANT_NAME=Jarvis
# Nome exibido no login (o nome real da agência vem do banco)
NEXT_PUBLIC_AGENCY_NAME=Agência X
