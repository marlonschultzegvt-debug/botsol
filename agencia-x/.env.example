# ── IA (obrigatório para as funções de IA) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo padrão (opcional). Padrão: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# ── Ferramenta Espião: dados reais do Instagram via Apify (opcional) ──
# Sem token, o Espião faz análise estimada a partir do que você colar.
APIFY_TOKEN=

# ── Banco de dados (Supabase ou Postgres) ────────────────────────
DATABASE_URL=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres

# ── Auth (próxima etapa) ─────────────────────────────────────────
AUTH_SECRET=gere-com-openssl-rand-base64-32

# ── Assistente ───────────────────────────────────────────────────
NEXT_PUBLIC_ASSISTANT_NAME=Jarvis
NEXT_PUBLIC_AGENCY_NAME=Agência X
